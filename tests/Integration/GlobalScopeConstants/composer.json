{
    "require": {
        "kint-php/kint": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Mozart\\TestProject\\": "src/"
        }
    },
    "extra": {
        "mozart": {
            "dep_namespace": "Mozart\\TestProject\\Dependencies",
            "dep_directory": "/src/dependencies/",
            "classmap_directory": "/classes/",
            "classmap_prefix": "MozartTest_",
            "constant_prefix": "MOZARTTEST_",
            "packages": [
                "kint-php/kint"
            ],
            "excluded_packages": [],
            "override_autoload": {
                "kint-php/kint": {
                    "files": ["init.php"]
                }
            },
            "delete_vendor_directories": true
        }
    }
}
